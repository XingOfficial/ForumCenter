<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>cn.xing.bbscenter</ApplicationId>
    <ApplicationVersion>20</ApplicationVersion>
    <ApplicationDisplayVersion>1.02-beta-20</ApplicationDisplayVersion>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AndroidSdkDirectory>/opt/android-sdk</AndroidSdkDirectory>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
  </PropertyGroup>

  <!-- 代码混淆和裁剪（仅 Release） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <AndroidEnableProguard>true</AndroidEnableProguard>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidLinkTool>r8</AndroidLinkTool>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- 只保留真机 ARM 架构，去掉 x86/x86_64（模拟器用），APK 体积减半 -->
    <AndroidSupportedAbis>armeabi-v7a;arm64-v8a</AndroidSupportedAbis>
    <!-- 发布为 APK 而非 AAB，方便直接安装 -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <!-- Release 签名配置 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildProjectDirectory)/forumcenter.jks</AndroidSigningKeyStore>
    <AndroidSigningStorePass>forumcenter</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>forumcenter</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>forumcenter</AndroidSigningKeyPass>
  </PropertyGroup>

  <!-- 混淆时保留必要的类型不被裁剪 -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="LinkerConfig.xml" />
  </ItemGroup>

  <!-- 应用图标 - 使用显式 AndroidResource 而非 MauiIcon（后者未正确生成资源） -->
  <ItemGroup>
    <AndroidResource Include="Resources\mipmap-anydpi-v26\appicon.xml" />
    <AndroidResource Include="Resources\mipmap-anydpi-v26\appicon_round.xml" />
    <AndroidResource Include="Resources\drawable\appicon_foreground.xml" />
    <AndroidResource Include="Resources\values\ic_launcher_background.xml" />
  </ItemGroup>

  <!-- 启动画面 -->
  <ItemGroup>
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2196F3" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.50" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.50" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="9.0.50" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
