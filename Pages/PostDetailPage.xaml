<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ForumCenter.Pages.PostDetailPage"
             Title="帖子详情"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <StackLayout Padding="16" Spacing="0">

                <!-- 作者行 -->
                <HorizontalStackLayout Spacing="8" Margin="0,0,0,8">
                    <Label x:Name="AuthorLabel" FontSize="14" TextColor="{StaticResource Primary}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAuthorTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TimeLabel" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                </HorizontalStackLayout>

                <!-- 标题 -->
                <Label x:Name="TitleLabel" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,0,0,8" />

                <!-- 正文 -->
                <Label x:Name="ContentLabel" FontSize="15" TextColor="{StaticResource TextPrimary}" LineBreakMode="WordWrap" Margin="0,0,0,12" />

                <!-- 点赞行 -->
                <HorizontalStackLayout Spacing="8" Margin="0,0,0,12">
                    <Button x:Name="LikeButton" Text="👍 赞" Clicked="OnLikeClicked" Padding="10,4" FontSize="13" BackgroundColor="Transparent" TextColor="{StaticResource Accent}" />
                    <Label x:Name="LikeCountLabel" FontSize="14" TextColor="{StaticResource Vote}" VerticalOptions="Center" />
                    <Label x:Name="ViewCountLabel" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" HorizontalOptions="EndAndExpand" />
                </HorizontalStackLayout>

                <!-- 分隔线 -->
                <BoxView HeightRequest="1" Color="{StaticResource Divider}" Margin="0,0,0,12" />

                <!-- 评论标题 -->
                <Label x:Name="CommentsLabel" Text="评论" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,0,0,8" />

                <!-- 评论列表 -->
                <StackLayout x:Name="CommentsContainer" Spacing="0" />

                <!-- 帮盲社区不支持评论提示 -->
                <Label x:Name="NoCommentHintLabel" Text="帮盲社区暂不支持评论" FontSize="14" TextColor="{StaticResource TextSecondary}" Margin="0,8" IsVisible="False" />

                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" Color="{StaticResource Primary}" Margin="0,8" />

            </StackLayout>
        </ScrollView>

        <!-- 底部评论输入 -->
        <Grid x:Name="CommentInputArea" Grid.Row="1" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource Background}" Padding="8">
            <Entry Grid.Column="0" x:Name="CommentEntry" Placeholder="写评论..." ReturnType="Send" Completed="OnCommentEntryCompleted" />
            <Button Grid.Column="1" x:Name="SendButton" Text="发送" Clicked="OnSendCommentClicked" Margin="8,0,0,0" />
        </Grid>
    </Grid>
</ContentPage>
