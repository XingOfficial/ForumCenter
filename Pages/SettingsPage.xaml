<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ForumCenter.Pages.SettingsPage"
             Title="设置"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <StackLayout Spacing="0" Padding="16">

            
            <Label Text="账号"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   Margin="0,8,0,8" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <Label Grid.Column="0"
                       x:Name="AccountStatusLabel"
                       FontSize="16"
                       TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        x:Name="LoginLogoutButton"
                        Text="登录"
                        Clicked="OnLoginLogoutClicked"
                        Padding="20,8" />
            </Grid>

            
            <BoxView HeightRequest="1" Color="{StaticResource Divider}" Margin="0,0,0,0" />

            
            <Label Text="显示设置"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   Margin="0,16,0,8" />

            <Label Text="字体大小"
                   FontSize="15"
                   TextColor="{StaticResource TextPrimary}"
                   Margin="0,0,0,4" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <Slider Grid.Column="0"
                        x:Name="FontSizeSlider"
                        Minimum="0"
                        Maximum="20"
                        ValueChanged="OnFontSizeChanged"
                        AutomationProperties.Name="字体大小滑块" />
                <Label Grid.Column="1"
                       x:Name="FontSizeLabel"
                       FontSize="14"
                       TextColor="{StaticResource TextSecondary}"
                       Margin="8,0,0,0"
                       VerticalOptions="Center" />
            </Grid>

            
            <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                <Label Grid.Column="0"
                       Text="启用发帖小尾巴"
                       FontSize="15"
                       TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center" />
                <Switch Grid.Column="1"
                        x:Name="PostTailSwitch"
                        Toggled="OnPostTailToggled"
                        AutomationProperties.Name="发帖小尾巴开关" />
            </Grid>

            <Label Text="发帖时自动添加：来自论坛中心APP"
                   FontSize="12"
                   TextColor="{StaticResource TextSecondary}"
                   Margin="0,4,0,0" />

        </StackLayout>
    </ScrollView>
</ContentPage>
