<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ForumCenter.Pages.MainPage"
             Title="论坛中心"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- 顶部 Toolbar + 社区选择 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource Primary}" Padding="8,0">
            <Label Grid.Column="0" Text="论坛中心" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" Margin="8,0" />
            <Picker Grid.Column="1"
                    x:Name="CommunityPicker"
                    TextColor="White"
                    BackgroundColor="{StaticResource Primary}"
                    Margin="0,4"
                    AutomationProperties.Name="社区切换" />
        </Grid>

        <!-- Tab 切换（带选中下划线指示器，匹配原版 TabLayout） -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" BackgroundColor="{StaticResource Primary}" Padding="0,0,0,0">
            <StackLayout Grid.Column="0" Spacing="0" VerticalOptions="Fill">
                <Button x:Name="TabAll" Text="全部" Clicked="OnTabClicked" Padding="0,8" FontSize="14" BackgroundColor="Transparent" TextColor="White" HorizontalOptions="Fill" />
                <BoxView x:Name="IndicatorAll" HeightRequest="3" Color="White" HorizontalOptions="Fill" />
            </StackLayout>
            <StackLayout Grid.Column="1" Spacing="0" VerticalOptions="Fill">
                <Button x:Name="TabNew" Text="最新" Clicked="OnTabClicked" Padding="0,8" FontSize="14" BackgroundColor="Transparent" TextColor="White" HorizontalOptions="Fill" />
                <BoxView x:Name="IndicatorNew" HeightRequest="3" Color="Transparent" HorizontalOptions="Fill" />
            </StackLayout>
            <StackLayout Grid.Column="2" Spacing="0" VerticalOptions="Fill">
                <Button x:Name="TabHot" Text="热门" Clicked="OnTabClicked" Padding="0,8" FontSize="14" BackgroundColor="Transparent" TextColor="White" HorizontalOptions="Fill" />
                <BoxView x:Name="IndicatorHot" HeightRequest="3" Color="Transparent" HorizontalOptions="Fill" />
            </StackLayout>
            <StackLayout Grid.Column="3" Spacing="0" VerticalOptions="Fill">
                <Button x:Name="TabGood" Text="精华" Clicked="OnTabClicked" Padding="0,8" FontSize="14" BackgroundColor="Transparent" TextColor="White" HorizontalOptions="Fill" />
                <BoxView x:Name="IndicatorGood" HeightRequest="3" Color="Transparent" HorizontalOptions="Fill" />
            </StackLayout>
        </Grid>

        <!-- 帖子列表 -->
        <ListView Grid.Row="2"
                  x:Name="PostsListView"
                  HasUnevenRows="True"
                  IsPullToRefreshEnabled="True"
                  Refreshing="OnRefreshing"
                  ItemTapped="OnPostTapped"
                  ItemAppearing="OnItemAppearing"
                  BackgroundColor="Transparent"
                  SeparatorVisibility="Default"
                  Margin="0,0,0,0"
                  AutomationProperties.Name="帖子列表">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Padding="12" Spacing="6">
                            <!-- 作者行 -->
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Username}" FontSize="13" TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding DisplayTime}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding SectionName}" FontSize="12" TextColor="{StaticResource Vote}" />
                            </HorizontalStackLayout>
                            <!-- 标题 -->
                            <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="2" TextColor="{StaticResource TextPrimary}" />
                            <!-- 摘要 -->
                            <Label Text="{Binding Content}" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="2" />
                            <!-- 统计行 -->
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{Binding CommentCount, StringFormat='{0}回复'}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding View, StringFormat='{0}浏览'}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </HorizontalStackLayout>
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部提示 -->
        <Label Grid.Row="3" x:Name="BottomHintLabel" FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" Padding="8" />

        <!-- 发帖浮动按钮 -->
        <Button Grid.Row="2"
                x:Name="CreatePostButton"
                Text="+"
                Clicked="OnCreatePostClicked"
                VerticalOptions="End"
                HorizontalOptions="End"
                Margin="0,0,20,20"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                FontSize="24"
                AutomationProperties.Name="发帖按钮" />

    </Grid>
</ContentPage>
